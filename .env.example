# Blastbox Configuration (copy to `.env` before bootstrapping your Fly.io Sprites)

# Sprite names (controller holds Connectors + dashboard; detonator stays unlabeled with `* -> deny` egress)
BLASTBOX_CONTROLLER_SPRITE=blastbox
BLASTBOX_DETONATOR_SPRITE=blastbox-detonator
BLASTBOX_CONTROLLER_LABEL=blastbox

# Sprites Connector IDs from your Fly.io org (`https://fly.io/dashboard/<org>/sprites/connectors`)
BLASTBOX_GITHUB_CONNECTOR_ID=<your-github-connector-id>
# LLM Connector: pick ONE provider (`openrouter`, `openai`, or `anthropic`)
BLASTBOX_LLM_PROVIDER=openrouter
BLASTBOX_OPENROUTER_CONNECTOR_ID=<your-openrouter-connector-id>
# BLASTBOX_OPENAI_CONNECTOR_ID=<your-openai-connector-id>
# BLASTBOX_ANTHROPIC_CONNECTOR_ID=<your-anthropic-connector-id>
BLASTBOX_SLACK_CONNECTOR_ID=<your-slack-bot-connector-id>
BLASTBOX_SLACK_PROVIDER=slack_bot

# Target GitHub repository (`owner/repo`) & Slack channel ID (right-click channel -> View details)
BLASTBOX_REPO=<owner>/<repo>
BLASTBOX_SLACK_CHANNELS=C0XXXXXXXXX
BLASTBOX_SLACK_CHANNEL_LABEL=#blastbox

# Optional overrides (public URL is auto-detected from `sprite info` when omitted)
# BLASTBOX_ALLOWED_PR_AUTHORS=<github-username>
# BLASTBOX_MAX_HISTORY_RUNS=50
# BLASTBOX_PUBLIC_URL=https://blastbox-xxxx.sprites.app
# BLASTBOX_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# BLASTBOX_POLL_INTERVAL=30
# BLASTBOX_SLACK_POLL_INTERVAL=15
# BLASTBOX_DETONATION_TIMEOUT=20
# BLASTBOX_MAX_CHECKPOINTS=8
# BLASTBOX_SPRITE_BIN=/usr/local/bin/sprite
