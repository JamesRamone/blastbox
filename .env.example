# Blastbox Configuration (copy to .env to customize for your Fly.io org)

# Sprite names (controller runs dashboard + agent + Connectors; detonator is unlabeled & deny-all egress)
BLASTBOX_CONTROLLER_SPRITE=blastbox
BLASTBOX_DETONATOR_SPRITE=blastbox-detonator
BLASTBOX_CONTROLLER_LABEL=hacksgiving

# Sprites Connector IDs from your Fly.io org (`sprite` gateway endpoints)
BLASTBOX_GITHUB_CONNECTOR_ID=<github-connector-id>
BLASTBOX_OPENROUTER_CONNECTOR_ID=<openrouter-connector-id>

# Target GitHub repository watched by the autonomous PR agent and used for demos
BLASTBOX_REPO=JamesRamone/hacksgiving-blastbox-demo

# Public dashboard URL of your controller Sprite
BLASTBOX_PUBLIC_URL=https://blastbox-3xb.sprites.app

# Optional overrides
# BLASTBOX_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# BLASTBOX_POLL_INTERVAL=30
# BLASTBOX_DETONATION_TIMEOUT=20
# BLASTBOX_MAX_CHECKPOINTS=8
# BLASTBOX_SPRITE_BIN=/usr/local/bin/sprite
